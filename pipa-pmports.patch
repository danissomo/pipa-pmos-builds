++		ret = nanosic_dev->irq_number;
++		goto err_regulator_disable;
++	}
++
++	ret = request_threaded_irq(nanosic_dev->irq_number,
++		nanosic_irq_handler, nanosic_interrupt_thread_fn,
++		0x6001, "nanosic_irq", nanosic_dev);
++
++	if (ret) {
