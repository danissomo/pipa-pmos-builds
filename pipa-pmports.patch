++static int nanosic_803_resume(struct device *dev)
++{
++	struct nanosic_803_priv *nanosic_dev = dev_get_drvdata(dev);
++	int ret;
++
++	// Turn the regulators on
++	ret = regulator_enable(nanosic_dev->vdd_1v8);
