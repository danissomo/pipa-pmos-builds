++				input_mt_report_slot_state(nanosic_dev->touchpad_input_dev, MT_TOOL_FINGER, 0);
++				nanosic_dev->slot_mapping[i] = -1;
++			}
++			continue;
++		}
++
++		int slot = nanosic_dev->slot_mapping[i];
