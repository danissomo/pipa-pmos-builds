++		input_report_abs(nanosic_dev->touchpad_input_dev, ABS_MT_POSITION_Y, y);
++	}
++
++	input_report_key(nanosic_dev->touchpad_input_dev, BTN_LEFT, (uint16_t)buf[4]);
